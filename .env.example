# Copy to .env -- NEVER commit .env
# --- optional LLM resume parsing ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# --- job search (free keys: https://developer.adzuna.com/) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
# adzuna | mock   (empty = Adzuna if keys are set, otherwise fictional demo jobs)
JOBS_PROVIDER=
JOBS_CACHE_TTL_SECONDS=43200
# --- storage (SQLite for dev; use your RDS URL in production, e.g. postgresql+psycopg://user:pass@host/db) ---
DATABASE_URL=sqlite:///./jobhunt.db
